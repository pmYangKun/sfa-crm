NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# 仅 server-side（Next.js Route Handler 调 backend）走的内部回环 URL。
# 浏览器拿不到这个 env（没有 NEXT_PUBLIC_ 前缀），只在 Route Handler 进程里有。
# 生产填 http://127.0.0.1:8000；dev 留空（fallback 到 NEXT_PUBLIC_BACKEND_URL）
# 为什么需要：spec 002 按 IP 限流，Route Handler 走外网公网 URL 会让 backend
# 看所有用户都是服务器自己出口 IP → 一个用户聊天就 429。
BACKEND_URL_INTERNAL=

# 百度统计 site ID（生产填，dev 留空避免本地点击污染线上统计）
# 当前与主站 www.pmyangkun.com 共享 site ID，靠 URL 维度在百度统计报表里区分 CRM 流量
NEXT_PUBLIC_BAIDU_ID=
